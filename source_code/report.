## 9. SOURCE CODE

```cpp
#include <iostream>
#include <vector>
#include <string>
using namespace std;

int main()
{
    int n, e;

    cout << "Enter number of courses: ";
    cin >> n;

    if (n <= 0)
    {
        cout << "Invalid number of courses!";
        return 0;
    }

    vector<string> course(n);
    vector<vector<int> > adj(n);

    for (int i = 0; i < n; i++)
    {
        cout << "Enter course name: ";
        cin >> course[i];
    }

    cout << "Enter number of prerequisite links: ";
    cin >> e;

    if (e < 0)
    {
        cout << "Invalid number of links!";
        return 0;
    }

    for (int i = 0; i < e; i++)
    {
        string from, to;
        int u = -1, v = -1;

        cout << "Enter course and linked course: ";
        cin >> from >> to;

        for (int j = 0; j < n; j++)
        {
            if (course[j] == from)
                u = j;

            if (course[j] == to)
                v = j;
        }

        if (u != -1 && v != -1)
            adj[u].push_back(v);
        else
            cout << "Invalid course name! Try again.\n";
    }

    cout << "\nCourse Adjacency List:\n";

    for (int i = 0; i < n; i++)
    {
        cout << course[i] << " -> ";

        for (int j = 0; j < (int)adj[i].size(); j++)
            cout << course[adj[i][j]] << " ";

        cout << endl;
    }

    string selected;

    cout << "\nEnter course to display linked courses: ";
    cin >> selected;

    int index = -1;

    for (int i = 0; i < n; i++)
    {
        if (course[i] == selected)
        {
            index = i;
            break;
        }
    }

    if (index != -1)
    {
        cout << "Directly linked courses of "
             << selected << ": ";

        if (adj[index].empty())
            cout << "None";
        else
        {
            for (int j = 0; j < (int)adj[index].size(); j++)
                cout << course[adj[index][j]] << " ";
        }

        cout << endl;
    }
    else
    {
        cout << "Course not found!" << endl;
    }

    return 0;
}
```

